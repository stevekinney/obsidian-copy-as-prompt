{
  "version": "0.2.0",
  "configurations": [
    {
      // The plugin itself runs inside Obsidian, not under Bun — to debug it,
      // use Obsidian's developer tools (Cmd+Opt+I). These configurations cover
      // the build and the tests, which do run under Bun.
      "name": "Watch Build",
      "type": "bun",
      "request": "launch",
      "program": "run",
      "args": ["dev"],
      "internalConsoleOptions": "neverOpen"
    },
    {
      "name": "Debug Tests",
      "type": "bun",
      "request": "launch",
      "program": "test"
    },
    {
      "name": "Debug Current File",
      "type": "bun",
      "request": "launch",
      "program": "${file}",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
