{
  "name": "copy-as-prompt",
  "version": "0.4.0",
  "author": "Steve Kinney <hello@stevekinney.net>",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "builtin-modules": "^5.3.0",
    "chalk": "^6.0.0",
    "change-case": "^5.4.4",
    "lefthook": "^2.1.10",
    "obsidian": "^1.13.1",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "sort-package-json": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "description": "Copy notes to the clipboard wrapped in a reusable prompt template.",
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevekinney/obsidian-copy-as-prompt.git"
  },
  "homepage": "https://github.com/stevekinney/obsidian-copy-as-prompt#readme",
  "bugs": "https://github.com/stevekinney/obsidian-copy-as-prompt/issues",
  "scripts": {
    "build": "bun run scripts/build.ts --production",
    "check": "bun run format:check && bun run lint && bun run typecheck",
    "clean": "rm -rf main.js coverage node_modules/.cache/tsconfig.tsbuildinfo node_modules/.cache/tsconfig.test.tsbuildinfo",
    "dev": "bun run scripts/build.ts --watch",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "prepare": "bun x lefthook install",
    "release": "bun run scripts/release.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit --project tsconfig.test.json",
    "validate": "bun run check && bun run typecheck:test && bun run test && bun run build && bun run verify:bundle",
    "version": "bun run scripts/sync-manifest-version.ts && git add manifest.json versions.json",
    "verify:bundle": "bun run scripts/verify-bundle.ts",
    "verify:release-version": "bun run scripts/verify-release-version.ts"
  },
  "type": "module"
}
