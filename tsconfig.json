{
  "compilerOptions": {
    // Environment and ECMAScript features. Obsidian plugins run in a browser
    // context (Electron's renderer on desktop, a WebView on mobile), so the
    // DOM libs are required for the Obsidian API to typecheck at all.
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "auto",
    "allowJs": false,
    "checkJs": false,

    // Module resolution
    "moduleResolution": "bundler",
    // The Bun hook scripts under `scripts/hooks/` import each other by .ts path.
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    // Type checking - Strict mode
    "strict": true,

    // Type checking - Additional checks
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true,

    // Error reporting
    "pretty": true,
    "noErrorTruncation": true,

    // Optimization
    "skipLibCheck": true,

    // Performance improvements
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo",

    // Path resolution
    "rootDir": ".",

    // DX improvements
    "preserveWatchOutput": true,

    // Bun types cover `scripts/` and the test setup. Nothing under `src/` may
    // use them — a Bun global in the bundle is a plugin that dies on mobile.
    "types": ["bun"]
  },
  "include": ["src", "scripts", "test"],
  "exclude": ["node_modules", "coverage", "main.js"]
}
